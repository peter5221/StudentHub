# StudentHub Server Environment Variables
PORT=5001
JWT_SECRET=studenthub_super_secret_jwt_key_2024
# Admin credentials (email of the admin account)
ADMIN_EMAIL=admin@studenthub.com
# Optional: MongoDB URI (if not set, SQLite will be used)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/studenthub
# Optional: Cloudinary credentials (if not set, local uploads folder will be used)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
