# ─── StudentHub — Environment Variables ───────────────────────────────────────
# Copy to server/.env and fill in real values.
# NEVER commit this file with secrets.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=https://yourdomain.com

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_at_least_64_chars_random_string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@studenthub.com
ADMIN_PASSWORD=CHANGE_ME_secure_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Storage (Cloudflare R2 / AWS S3-compatible) ───────────────────────────────
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=studenthub-uploads
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_REGION=auto

# ── CDN ───────────────────────────────────────────────────────────────────────
CDN_BASE_URL=https://cdn.yourdomain.com

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_BUCKET=studenthub-backups
BACKUP_RETENTION_DAYS=30

# ── Error Monitoring (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# ── External Services ─────────────────────────────────────────────────────────
GEOCODE_API_KEY=CHANGE_ME

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

