# Dependencies — always reinstalled inside the container
node_modules
**/node_modules

# Local env files — never bake secrets into images
.env
**/.env
.env.*
**/.env.*

# Git internals
.git
.gitignore
.github

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.log
*.tmp

# Dev / test artifacts
coverage
.nyc_output

# Build output (re-generated inside container)
dist
build

# Documentation
*.md
!README.md
